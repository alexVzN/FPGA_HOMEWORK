# --- Vivado: тимчасові/відтворювані артефакти ---
# журнали та логи запусків
*.jou
*.log
*.str
# службові теки проєкту (кеш, результати запусків, симуляція, згенероване)
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.gen/
*.srcs/ip/**/tmp/
.Xil/
# бекапи та автозбереження
*.bak
*.orig
*~

# Залишаємо в репозиторії (перелічено для ясності, git і так їх бере):
#   *.xpr        — файл проєкту Vivado
#   *.vhd *.sv   — вихідні коди
#   *.xdc        — констрейнти
#   screenshots/ — скріншоти симуляцій та звітів
