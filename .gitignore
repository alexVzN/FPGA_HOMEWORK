# ---- MicroBlaze BD (non-standard dir): keep only .bd + top wrapper ----
# everything else under the BD dir is generated from .bd (ip/, ipshared/, synth/, sim/, hw_handoff/, *.veo/.vho/.sv/.bmm/.bxml/.ooc.xdc)
